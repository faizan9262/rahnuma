# =========================================================================
# Python / FastAPI Backend
# =========================================================================

# Virtual Environment
# Never commit your virtual environment folder.
venv/
.venv/
env/
.env/

# Python Caches
# These are generated by the Python interpreter.
__pycache__/
*.pyc
*.pyo
*.pyd

# Database Files
# Ignore local database files and vector stores.
*.sqlite3
*.db
chromadb_store/

# Environment Variables
# CRITICAL: Never commit your .env file containing secrets.
.env
.env.*

# Uploaded/Static Files
# CRITICAL: Ignore local static/uploaded files.
# If your documents are directly in 'static/', use 'static/'
# If they are in a subfolder like 'static/uploads/', use 'static/uploads/'
static/          # This line will ignore the entire static folder and its contents

# Test & Coverage Reports
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml

# Build & Distribution Artifacts
build/
dist/
*.egg-info/
*.egg


# =========================================================================
# Vite / React Frontend
# =================================2========================================

# Node Modules
# Never commit the massive node_modules folder.
node_modules/

# Build Output
# The 'dist' folder is generated when you build the frontend.
dist/
.vite/

# Local Environment Variables
# These often contain local-only API keys or settings.
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*


# =========================================================================
# General / IDE Specific
# =========================================================================

# Editor Directories
# For VSCode and JetBrains IDEs (PyCharm, WebStorm).
.vscode/
.idea/

# OS Files
# For macOS, Windows, and Linux.
.DS_Store
Thumbs.db
desktop.ini